---
import presentationData from "../presentation.json";
import ButtonVideo from "./Utility/ButtonVideo.astro";
---

<section class="h-[100vh] sm:h-[50vh] lg:h-[85vh] 2xl:h-[90vh] relative">
  <div class="h-full w-[85%] mx-auto flex justify-between flex-col py-8 ">
    <!-- pt-25 sm:pt-10 md:pt-10 pb-10 px-5 -->
    <div class="md:flex md:justify-between md:items-center  ">
      <span class="text-white 2xl:text-4xl sm:text-2xl md:text-sm lg:text-2xl xl:text-3xl title"> / You Choose</span>
      <ul class="flex gap-4 text-white font-semibold  ">
        {
          presentationData.map((item, index) => (
            <li>
              <ButtonVideo
                title={item.title}
                dataSrc={item.src}
                dataDesc={item.description}
                active={index === 0}
              />
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <span id="video-description" class="block text-white text-5xl sm:text-4xl md:text-2xl lg:text-6xl xl:text-7xl title tracking-wider">
        {presentationData[0].description}
      </span>
    </div>
  </div>

  <video
    autoplay
    muted
    playsinline
    preload="auto"
    class="absolute inset-0 w-full h-full object-cover -z-1"
  >
    <source id="video-source" src="./videos/Video1.mp4" type="video/mp4" />
  </video>

  <script >
  import presentationData from "../presentation.json";
  
    const buttonsVideo = document.getElementsByClassName("button-video");
    const descriptionVideo = document.getElementById("video-description");
    const video = document.querySelector("video");
    const videoSource = document.getElementById("video-source")

    let currentIndex = 0;

    function waitForCanPlay(vid){
      return new Promise((resolve) => {
        if(vid.readyState >= 3) return resolve();
        vid.addEventListener("canplay",() => resolve(), {once:true})
      })
    }

    async function updateVideo(){
      const data = presentationData[currentIndex];

    descriptionVideo.textContent = data.description;

    video.pause();
    videoSource.setAttribute("src", data.src);
    video.load();

    await waitForCanPlay(video);

    try {
      await video.play();
    } catch (err) {
      console.debug("play() fue bloqueado o falló:", err);
    }
  }

  // Botones manuales
  Array.from(buttonsVideo).forEach((button, index) => {
    button.addEventListener("click", () => {
      currentIndex = index;
      updateVideo();
      updateButtons();
    });
  });

  function updateButtons() {
    Array.from(buttonsVideo).forEach((btn, idx) => {
      const active = idx === currentIndex;
      btn.classList.toggle("bg-gray-600", active);
      btn.classList.toggle("text-white", active);
      btn.classList.toggle("bg-white", !active);
      btn.classList.toggle("text-gray-500", !active);
    });
  }

  video.addEventListener("ended", () => {
    currentIndex = (currentIndex + 1) % presentationData.length; // loop
    updateVideo();
    updateButtons();
  });
  </script>
</section>
