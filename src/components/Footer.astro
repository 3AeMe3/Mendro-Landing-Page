---
import Circle from "./Utility/Circle.astro"
---
<section class="h-[60vh] text-sm flex flex-col font-bold justify-between gap-10 py-10 px-10 bg-black text-white">

    
    <div class="flex flex-col flex-1/5  mb-auto ">
        <span > <Circle color="white"/> STAY IN THE KNOW</span>
        <div class=" flex ml-7 mt-5 gap-3">
            <input class=" border-b-2 border-gray-500/80" placeholder="Enter your email" type="email">
            <button>SEND</button>
        </div>
    </div>

    
    <div class="flex flex-col flex-1  mb-auto ">
        <span > <Circle color="white"/> LET'S CONNECT</span>
        <div class=" flex flex-col ml-7 mt-5 gap-3 ">
            <a href="#">LINKEDIN</a>
            <a href="#">INSTAGRAM</a>
            <a href="#">TIKTOK</a>
        </div>
    </div>

    
    <div class="flex flex-col flex-1  mb-auto ">
        <span > <Circle color="white"/> LET'S CONNECT</span>
        <div class=" flex flex-col ml-7 mt-5 gap-3 ">
            <a href="#">LINKEDIN</a>
            <a href="#">INSTAGRAM</a>
            <a href="#">TIKTOK</a>
        </div>
    </div>
    
</section>