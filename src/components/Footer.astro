---
import Circle from "./Utility/Circle.astro"
---
<section class="h-[60vh] flex sm:flex-col md:flex-row md:h-[30vh] md:text-[10px] text-sm  font-bold justify-between gap-10 py-10 px-10 bg-black text-white">

    
    <div class="flex flex-col flex-1/5  mb-auto ">
        <span > <Circle color="white"/> STAY IN THE KNOW</span>
        <div class=" flex ml-7 md:ml-6 mt-5 gap-3">
            <input class=" border-b-2 border-gray-500/80" placeholder="Enter your email" type="email">
            <button>SEND</button>
        </div>
    </div>

    
    <div class="flex flex-col flex-1  mb-auto ">
        <span > <Circle color="white"/> LET'S CONNECT</span>
        <div class=" flex flex-col ml-7 md:ml-6 mt-5 gap-3 ">
            <a href="#">LINKEDIN</a>
            <a href="#">INSTAGRAM</a>
            <a href="#">TIKTOK</a>
        </div>
    </div>

    
    <div class="flex flex-col flex-1  mb-auto ">
        <span > <Circle color="white"/> 2025 MENDRO</span>
        <div class=" flex flex-col ml-7 md:ml-6 mt-5 gap-3 ">
            <a href="#">LEGAL NOTICE</a>
            <a href="#">COOKIES POLICY</a>
            <a href="#">COOKIES PREFERENCES</a>
        </div>
    </div>
    
</section>