---
const { title, dataSrc, active, dataDesc } = Astro.props;

const baseClass = `button-video cursor-pointer transition-all  text-gray-500 px-3 py-1 active:brightness-90 active:translate-y-[2px] `;
const activeClass = active
  ? "bg-gray-600 text-white"
  : "bg-white text-gray-500";
---

<button
  data-src={dataSrc}
  class={`${baseClass} ${activeClass}`}
  data-description={dataDesc}
>
  {title}
</button>
