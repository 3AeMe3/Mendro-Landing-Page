<header class=" w-full fixed top-0 z-50">
  <nav class="  mx-auto md:flex md:justify-between "> 
    <!-- md:px-5 -->
    <div class="nav-bg bg-white w-full h-[2.85em] mx-auto -z-1 fixed md:px-5 "></div>
    <div
      class="nav-border border-b-2 border-dotted border-white/20  flex items-center justify-between w-full px-4 pt-1 overflow-hidden relative  "
    >
      <!-- Brand -->
      <div class="brand-container overflow-hidden transition-all duration-700 h-10 flex items-center">
        <span
          class="brand-text text-4xl title  transition-opacity duration-500 md:text-xl xl:text-3xl"
          >MENDRO
        </span>
      </div>

      <!-- Botón hamburguesa -->
      <div id="button-menu" class=" flex items-center gap-2 text-white md:hidden"
      >
        <span class="text-sm">MENU</span>
        <button class="md:hidden p-2" aria-label="Open menu">
          <!-- Hamburger Menu -->
          <div class="relative flex justify-center items-center">
            <span class="border-1 w-4 hidden"></span>
            <span class="absolute border-1 h-2"></span>
            <span class="absolute border-1 w-2"></span>
          </div>
        </button>
      </div>
    </div>

    <!-- Menú principal -->
    <ul id="main-menu"
      class=" ml-[1px] nav-border border-b-2 border-dotted border-white/20 text-white  justify-end hidden sm:hidden md:inline-flex  md:pr-10 md:whitespace-nowrap gap-10 items-center  "
    >
      <li><a href="">Home</a></li>
      <li><a href="">Works</a></li>
      <li><a href="" >About Us</a></li>
    </ul>

    <!-- Menú móvil -->
    <div id="mobile-menu"  class="hidden origin-top overflow-hidden">
      <ul
        class="flex flex-col items-center gap-4 bg-white p-4 md:hidden"
      >
        <li><a href="" class="text-black">Home</a></li>
        <li><a href="" class="text-black">Works</a></li>
        <li><a href="" class="text-black">About Us</a></li>
      </ul>
    </div>
  </nav>
</header>

<script>
  import { gsap } from "gsap";
  const buttonMenu = document.getElementById("button-menu");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuItems = mobileMenu.querySelectorAll("li");

  let isOpen = false;
  let isHome = true;
   let lastScrollTop = 0;
  window.addEventListener("scroll", () => {
    const currentScrool = window.scrollY;
    if (currentScrool > lastScrollTop) {
      navTl.play();
      isHome = false;
      //Navbar active
    }else if(currentScrool === lastScrollTop && !isOpen){
      navTl.reverse();
      isHome = true;

    } 
  });


    gsap.set(mobileMenu, { transformOrigin: "top", scaleY: 0, opacity: 0 });
    gsap.set(menuItems, { opacity: 0, y: -10 }); // ítems ocultos y un poquito arriba
    buttonMenu.addEventListener("click", () => {
  if (!isOpen) {
    mobileMenu.classList.remove("hidden");
    navTl.play();
    // Timeline para abrir
    const tlOpen = gsap.timeline();
    tlOpen
      .to(mobileMenu, {
        scaleY: 1,
        opacity: 1,
        duration: 0.35,
        ease: "power2.out",
      })
      .to(
        menuItems,
        {
          opacity: 1,
          y: 0,
          duration: 0.3,
          stagger: 0.1, // efecto escalonado
          ease: "power2.out",
        },
        "-=0.1" // empieza casi al mismo tiempo
      );
  } else {
    // Timeline para cerrar
    const tlClose = gsap.timeline({
      onComplete: () => {
        mobileMenu.classList.add("hidden");
        if(isHome){
          navTl.reverse();
        }

      }
    });

    tlClose
      .to(menuItems, {
        opacity: 0,
        y: -10,
        duration: 0.25,
        ease: "power2.in",
      })
      .to(mobileMenu, {
        scaleY: 0,
        opacity: 0,
        duration: 0.25,
        ease: "power2.in",
      });
  }

  isOpen = !isOpen;
  });
 
   
   const navTl = gsap.timeline({paused:true});
   
   navTl.fromTo([".nav-bg",".brand-text"],{
      y: -50,
      ease: "power1.in",
      duration: .3,
      delay: .3,
   },{
      y: 0,
      ease: "power1.out",
      duration: .3,
      delay: .3,

   },0).to(["#main-menu",buttonMenu,".nav-border"],{
      color:"black",
      ease: "power1.in",
      duration: 0.2,
      borderColor: "black"

   },.3)

   
  
</script>

