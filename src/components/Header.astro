<header class="w-full fixed top-0 z-50">
  <nav class="max-w-6xl mx-auto">
    <div
      id="navbar-container"
      class="flex items-center justify-between w-full px-4 pt-1 overflow-hidden relative"
    >
      <!-- Brand -->
      <div
        id="brand-container"
        class="overflow-hidden transition-all duration-700 h-0 flex items-center"
      >
        <span
          id="nav-brand"
          class="text-4xl title opacity-0 transition-opacity duration-500"
          >MENDRO</span
        >
      </div>

      <!-- Botón hamburguesa -->
      <div id="menu-button" class="flex items-center gap-2 text-white">
        <span class="text-sm">MENU</span>
        <button class="md:hidden p-2" aria-label="Open menu">
          <!-- Hamburger Menu -->
          <div class="relative flex justify-center items-center">
            <span class="border-1 w-4 hidden"></span>
            <span class="absolute border-1 h-2"></span>
            <span class="absolute border-1 w-2"></span>
          </div>
        </button>
      </div>
    </div>

    <!-- Menú principal -->
    <ul class="hidden md:flex gap-10 items-center">
      <li><a href="" class="text-white">Home</a></li>
      <li><a href="" class="text-white">Works</a></li>
      <li><a href="" class="text-white">About Us</a></li>
    </ul>

    <!-- Menú móvil -->
    <div id="mobile-menu" class="hidden">
      <ul
        class="flex flex-col items-center gap-4 bg-white p-4 md:hidden rounded"
      >
        <li><a href="" class="text-black">Home</a></li>
        <li><a href="" class="text-black">Works</a></li>
        <li><a href="" class="text-black">About Us</a></li>
      </ul>
    </div>
  </nav>
</header>

<script is:inline>
  const menuButton = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-menu");
  const brandContainer = document.getElementById("brand-container");

  const navBrand = document.getElementById("nav-brand");
  const navbar = document.querySelector("nav");

  let lastScrollTop = 0;
  let isHome = true;
  window.addEventListener("scroll", () => {
    const currentScrool = window.scrollY;

    if (currentScrool > lastScrollTop) {
      isHome = false;
      menuBarActive();
    } else {
      menuBarInactive();
      isHome = true;
    }
  });

  menuButton.addEventListener("click", () => {
    console.log(lastScrollTop);
    if (menu.classList.contains("hidden")) {
      menuBarActive();
      menu.classList.remove("hidden");
    } else {
      if (isHome) {
        menuBarInactive();
        console.log(isHome);
      } else {
        menuHidden();
        console.log(isHome);
      }
    }
  });

  const menuBarActive = () => {
    navbar.classList.add("bg-white");
    brandContainer.classList.remove("h-0");
    brandContainer.classList.add("h-[60px]");
    navBrand.classList.remove("opacity-0");
    menuButton.classList.add("menu-active");
  };

  const menuHidden = () => {
    menu.classList.add("hidden");
    menuButton.classList.add("menu-active");
  };
  const menuBarInactive = () => {
    navbar.classList.remove("bg-white");
    brandContainer.classList.remove("h-[60px]");
    brandContainer.classList.add("h-0");
    navBrand.classList.add("opacity-0");
    menu.classList.add("hidden");
    menuButton.classList.remove("menu-active");
  };
</script>
