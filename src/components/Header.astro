<header class="w-full fixed top-0 z-50">
  <nav class=" max-w-6xl mx-auto md:flex md:justify-between">
    <div
      class="flex items-center justify-between w-full px-4 pt-1 overflow-hidden relative"
    >
      <!-- Brand -->
      <div class=" brand-container md: overflow-hidden transition-all duration-700 h-0 flex items-center">
        <span
          class="brand-text text-4xl title opacity-0 transition-opacity duration-500"
          >MENDRO
        </span>
      </div>

      <!-- Botón hamburguesa -->
      <div id="button-menu" class=" flex items-center gap-2 text-white md:hidden"
      >
        <span class="text-sm">MENU</span>
        <button class="md:hidden p-2" aria-label="Open menu">
          <!-- Hamburger Menu -->
          <div class="relative flex justify-center items-center">
            <span class="border-1 w-4 hidden"></span>
            <span class="absolute border-1 h-2"></span>
            <span class="absolute border-1 w-2"></span>
          </div>
        </button>
      </div>
    </div>

    <!-- Menú principal -->
    <ul id="main-menu"
      class=" text-white justify-end hidden sm:hidden md:inline-flex  md:pr-10 md:whitespace-nowrap gap-10 items-center  "
    >
      <li><a href="">Home</a></li>
      <li><a href="">Works</a></li>
      <li><a href="" >About Us</a></li>
    </ul>

    <!-- Menú móvil -->
    <div id="mobile-menu" class="hidden">
      <ul
        class="flex flex-col items-center gap-4 bg-white p-4 md:hidden rounded "
      >
        <li><a href="" class="text-black">Home</a></li>
        <li><a href="" class="text-black">Works</a></li>
        <li><a href="" class="text-black">About Us</a></li>
      </ul>
    </div>
  </nav>
</header>

<script is:inline>
  const buttonMenu = document.getElementById("button-menu");
  const mobileMenu = document.getElementById("mobile-menu");
  const nav = document.querySelector("nav");
  
  let lastScrollTop = 0;
  let isHome = true;
  window.addEventListener("scroll", () => {
    const currentScrool = window.scrollY;
    if (currentScrool > lastScrollTop) {
      isHome = false;
      nav.classList.add("navbar-active")
      //Navbar active
    }else if(currentScrool === lastScrollTop){
      isHome=true;
      nav.classList.remove("navbar-active");
    } 
    //lastScrollTop = currentScrool <= 0 ? 0 : currentScrool;
  });

   buttonMenu.addEventListener("click", () =>
    {
      if(isHome){
        nav.classList.add("navbar-active");
      }
      mobileMenu.classList.toggle("hidden");
   });

  
</script>
