---
import DotSeparation from "./Utility/DotSeparation.astro";
---

<section class="h-screen sm:h-[78vh] bg-white flex flex-col text-left pt-15 px-4">
  <h2 class="text-3xl font-normal mb-4">
    <span class="inline-block bg-black h-5 w-5 border-black rounded-2xl mr-4"
    ></span>
    Inside (the) Mendro
  </h2>
  <p class="max-w-2xl text-3xl">
    <span class="text-gray-500">
      At MENDRO, we believe in more than just fashion.
    </span> We are a community of individuals who express themselves through unique
    styles and sustainable choices. Our mission is to provide <span
      class="bg-black text-white px-1 rounded-sm"
    >
      high-quality
    </span>.
  </p>
  <div class="mt-8 flex flex-col">
    <DotSeparation dots="..........................." />
    <a href="#" class="font-semibold text-sm tracking-wide">MORE ABOUT US </a>
  </div>
</section>
